        function setCookie(key,val,exdays) {
            var expires = "; expires=Fri, 31 Dec 9999 23:59:59 GMT";
            if (exdays) {
                var d = new Date();
                d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
                expires = "; expires=" + d.toUTCString();
            }
                            document.cookie = key + "=" + (JSON.stringify(val) || "")  + expires + "; path=/;" + "domain=.bynogame.com";
                    }

        function getCookie(cname) {
            var name = cname + "=";
            var decodedCookie = decodeURIComponent(document.cookie);
            var ca = decodedCookie.split(';');
            for (var i = 0; i < ca.length; i++) {
                var c = ca[i];
                while (c.charAt(0) === ' ') {
                    c = c.substring(1);
                }
                if (c.indexOf(name) === 0) {
                    return c.substring(name.length, c.length);
                }
            }
            return "";
        }</script> <script src=//cdn.jsdelivr.net/npm/vanilla-lazyload@17.5.0/dist/lazyload.min.js></script> <script>var lazyLoadInstance = new LazyLoad({
